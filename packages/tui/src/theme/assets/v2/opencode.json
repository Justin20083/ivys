        "900": "#f7f4fc"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "categorical": ["purple", "orange", "green", "blue", "red"],
    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.neutral.900"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.500"
    },
    "scrollbar": {
      "base": "$hue.neutral.400"
    },
    "diff": {
      "background": {
        "added": "$hue.green.700",
        "removed": "$hue.red.700"
      },
      "lineNumber": {
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.red.800"
        }
      }
    },
    "syntax": {
      "number": "$hue.orange.200",
      "type": "$hue.orange.100"
    }
  },
  "dark": {
