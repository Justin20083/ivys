        "300": "#3d66b5",
        "400": "#6082c9",
        "500": "#87a1d9",
        "600": "#abc0e7",
        "700": "#cbdcf1",
        "800": "#e4eef8",
        "900": "#f4f8fc"
      },
      "purple": {
        "100": "#4a3585",
